# Nginx site for GC dashboard on port 8080 (Hostinger VPS with LiteSpeed on port 80).
#
# Install:
#   sudo cp deploy/nginx-gc-dashboard-8080.conf.example /etc/nginx/sites-available/gc-dashboard
#   sudo htpasswd -c /etc/nginx/.htpasswd-gc-dashboard partner_name
#   sudo ln -sf /etc/nginx/sites-available/gc-dashboard /etc/nginx/sites-enabled/gc-dashboard
#   sudo rm -f /etc/nginx/sites-enabled/default
#   # If another nginx site uses port 80, disable it: sudo rm /etc/nginx/sites-enabled/OTHER_SITE
#   sudo nginx -t && sudo systemctl reload nginx
#
# Toggle without uninstalling:
#   ./scripts/toggle-public-access.sh off
#   ./scripts/toggle-public-access.sh on

upstream gc_dashboard {
    server 127.0.0.1:8765;
    keepalive 8;
}

server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    location / {
        auth_basic "GC Used Gear Dashboard";
        auth_basic_user_file /etc/nginx/.htpasswd-gc-dashboard;

        proxy_pass http://gc_dashboard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
